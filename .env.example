# ==========================================
# LOANORBIT — Environment Configuration Template
# ==========================================

# Application
ENVIRONMENT=development
PROJECT_NAME="LOANORBIT"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Comma separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost"

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=loanorbit_user
POSTGRES_PASSWORD=loanorbit_secure_password
POSTGRES_DB=loanorbit_db
DATABASE_URL=postgresql+asyncpg://loanorbit_user:loanorbit_secure_password@postgres:5432/loanorbit_db
SYNC_DATABASE_URL=postgresql://loanorbit_user:loanorbit_secure_password@postgres:5432/loanorbit_db

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Document Storage
STORAGE_DIR="/opt/loanorbit/storage/private"
MAX_UPLOAD_SIZE_BYTES=5242880 # 5MB

# Synthetic Simulation Flags (Always True for Sandbox)
IS_SANDBOX_DEMO=true
MOCK_OTP_DEFAULT_CODE="123456"
ENABLE_MOCK_LENDER_AUTO_DISBURSE=true
ENABLE_MOCK_PAYMENT_AUTO_SUCCESS=true

# Admin Bootstrapping
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@loanorbit.demo
SUPER_ADMIN_PASSWORD=AdminSecurePass123!
